{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!strinc.mjs",
      "!src/utils/vanilla-extract",
      "!src/utils/strinc.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "html": {
    "formatter": {
      "enabled": true
    },
    "experimentalFullSupportEnabled": true
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "correctness": {
        "useQwikValidLexicalScope": "off"
      },
      "performance": {
        "useSolidForComponent": "off"
      },
      "preset": "all",
      "style": {
        "noHexColors": "off",
        "noIncrementDecrement": "off",
        "noMagicNumbers": "off",
        "noNestedTernary": "off",
        "noTernary": "off",
        "useExplicitLengthCheck": "off",
        "useFilenamingConvention": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "useJsxKeyInIterable": "off"
          },
          "suspicious": {
            "noUnknownAttribute": {
              "level": "warn",
              "options": {
                "ignore": ["class", "class:list"]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/*.config.mjs"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnresolvedImports": "off"
          },
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.css.ts"],
      "linter": {
        "rules": {
          "style": {
            "useExportsLast": "off",
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["src/**/*"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnresolvedImports": "off"
          }
        }
      }
    }
  ],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  }
}
